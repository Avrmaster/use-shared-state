		"@types/react-dom": "^19.2.3",
		"prettier": "^3.7.4",
		"rimraf": "^6.1.2",
		"rollup": "^4.54.0",
		"rollup-plugin-dts": "^6.3.0",
		"rollup-plugin-esbuild": "^6.2.1",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"react": "^19.2.3",
		"react-dom": "^19.2.3"
